# ==============================================================================
# SMART STUDENT MANAGER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL / Neon / Supabase):
# Replace with your pooled connection string:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Production Direct Connection (Required for Prisma migrations with connection poolers):
# DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret key for signing session JWT tokens.
# Generate on Linux/macOS with: openssl rand -base64 32
# Generate on Windows PowerShell with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
AUTH_SECRET="your-secure-random-auth-secret-min-32-characters-change-in-production"

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT & APPLICATION URL
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AI & SMART IMPORT (OPTIONAL / SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Google Gemini API key used for Smart Import image extraction (Attendance & Grades).
# Required ONLY for AI Smart Import. Manual entry and CSV/TSV imports work without it.
# SECURITY: Server-side secret only. NEVER prefix with NEXT_PUBLIC_.
# NEVER commit your real API key to source control.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key-here"

# Multimodal Gemini model name (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
